// =====================================================================
// D02 - Credential Dumping via LSASS Memory Access
// =====================================================================
// MITRE ATT&CK : T1003.001 - OS Credential Dumping: LSASS Memory
// Tactic       : Credential Access
// Severity     : High
// Data source  : Sysmon Event ID 10 (Process access)
// Author       : Umang Udeshi
//
// Description:
//   Flags any process, other than Windows startup processes, that opens
//   lsass.exe with access rights that allow reading its memory. LSASS
//   holds credentials of logged-in users, so this is how tools like
//   Mimikatz steal passwords.
//
// Tested against: OTRF APT29 Day 1 (196,081 events)
//   True positives : 3 (SCRANTON 23:05:16 x2, NASHUA 23:09:29 UTC)
//   False positives: 0 (wininit/csrss boot activity excluded by allowlist)
//
// Known false positives:
//   EDR/antivirus agents and some backup tools. Add them to
//   allowedSources by full path after verifying.
//
// Essential Eight mitigation:
//   Restrict administrative privileges (dumping LSASS requires admin).
//   Also enable LSA Protection (RunAsPPL) and Credential Guard.
// =====================================================================
let highRiskAccess = dynamic(["0x1fffff", "0x1f3fff", "0x1010", "0x1410", "0x143a", "0x1f0fff"]);
let allowedSources = dynamic([
    "C:\\windows\\system32\\wininit.exe",
    "C:\\windows\\system32\\csrss.exe"
]);
Apt29Raw
| where Channel == "Microsoft-Windows-Sysmon/Operational" and EventID == 10
| where TargetImage endswith "lsass.exe"
| where GrantedAccess in (highRiskAccess)
| where SourceImage !in~ (allowedSources)
| project EventTime, Hostname, SourceImage, GrantedAccess
| order by EventTime asc
